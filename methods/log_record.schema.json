{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Icarus Online - The Garden Study Log (proposal)",
  "description": "Template contract. Logs will be generated only by a future separately authorized runner; never give arm metadata to blinded raters.",
  "type": "object",
  "required": ["trajectory_id","arm","phase","session_number","model_snapshot","source_sha256","assembled_context_sha256","memory_enabled","memory_namespace","timestamp_utc","status"],
  "properties": {
    "trajectory_id":{"type":"string", "pattern":"^T[0-9]{4,}$"},
    "arm":{"enum":["N0","G0","N1","G1"]},
    "phase":{"enum":["baseline","exposure","immediate","withdrawal","transfer"]},
    "session_number":{"type":"integer", "minimum":1, "maximum":13},
    "model_snapshot":{"type":"string"},
    "harness_commit":{"type":["string","null"]},
    "source_sha256":{"type":["string","null"]},
    "assembled_context_sha256":{"type":"string"},
    "task_hash":{"type":["string","null"]},
    "memory_enabled":{"type":"boolean"},
    "memory_namespace":{"type":"string"},
    "memory_reads":{"type":"array","items":{"type":"string"}},
    "memory_writes":{"type":"array","items":{"type":"string"}},
    "timestamp_utc":{"type":"string","format":"date-time"},
    "response_path":{"type":["string","null"]},
    "tool_calls":{"type":"array","items":{"type":"object"}},
    "tokens_in":{"type":["integer","null"],"minimum":0},
    "tokens_out":{"type":["integer","null"],"minimum":0},
    "cost_usd":{"type":["number","null"],"minimum":0},
    "status":{"enum":["completed","failed","skipped","excluded"]},
    "exclusion_reason":{"type":["string","null"]},
    "privacy_incident":{"type":"boolean"}
  },
  "additionalProperties":true
}
